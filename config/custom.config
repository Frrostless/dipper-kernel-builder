# Custom kernel config for Xiaomi Mi 8 (dipper)
# Additional options beyond droidspaces.config

# Disable strong stack protector (not supported by Proton Clang)
# CONFIG_CC_STACKPROTECTOR_STRONG is not set
CONFIG_CC_STACKPROTECTOR=y

# Disable CRC checks for vendor module compatibility
CONFIG_MODULE_FORCE_LOAD=y

# SELinux permissive (useful for debugging)
# CONFIG_SECURITY_SELINUX_ALWAYS_ENFORCE is not set
# CONFIG_SECURITY_SELINUX_ALWAYS_PERMISSIVE=y

# Disable localversion auto (removes -dirty suffix)
CONFIG_LOCALVERSION_AUTO=n

# Enable additional useful options
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_POSIX_ACL=y
